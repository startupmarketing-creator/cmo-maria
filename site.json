    "about": {
      "blocks": [
        {
          "type": "paragraph",
          "text": "I'm Maria Artemeva — a CMO and marketing consultant with 20+ years of experience across retail, food delivery, SaaS, and EdTech. I've built marketing teams and systems at companies ranging from #1 market leaders to early-stage US startups."
        },
        {
          "type": "paragraph",
          "text": "My focus is practical: full-funnel marketing systems that lower CAC, grow CRM revenue, and improve retention — all grounded in real customer data rather than assumptions."
        },
        {
          "type": "paragraph",
          "text": "Based in Portugal. Available for fractional CMO roles and strategic advisory engagements globally."
        }
      ]
    }
